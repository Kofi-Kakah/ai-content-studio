# ------------------------------------------------------------------
# AI Content Studio — API server
# ------------------------------------------------------------------

# PostgreSQL connection string.
# Local dev (embedded postgres via `npm run db:start`):
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/aistudio"
# Production (Neon):
# DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# HTTP
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the web app)
CORS_ORIGIN="http://localhost:3000"

# Shared secret with the web app — used to sign/verify session JWTs.
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-please-32-chars-minimum"

# Public URL of the web app (used for links in emails)
APP_URL="http://localhost:3000"

# --------------------------- NVIDIA AI ----------------------------
# https://build.nvidia.com → get an API key (nvapi-...)
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
AI_MODEL="deepseek-ai/deepseek-v4.1-flash"

# ------------------------ Resend (email) --------------------------
# https://resend.com → API key (re_...)
RESEND_API_KEY=""
EMAIL_FROM="AI Content Studio <onboarding@resend.dev>"

# --------------------- Upstash Redis (cache/limits) ---------------
# https://upstash.com → create a Redis database
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --------------------- Backblaze B2 (file uploads) ----------------
# https://backblaze.com → App key with read/write on the bucket
B2_KEY_ID=""
B2_APP_KEY=""
B2_BUCKET=""
B2_REGION="us-west-004"
# Optional: friendly CDN domain in front of the bucket
B2_PUBLIC_BASE_URL=""
# "b2" when configured, otherwise files are stored locally (dev)
STORAGE_DRIVER="local"

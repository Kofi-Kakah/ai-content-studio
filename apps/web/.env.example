# ------------------------------------------------------------------
# AI Content Studio — web app (Next.js)
# ------------------------------------------------------------------

# Shared secret with the API server (must match apps/api/.env AUTH_SECRET)
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-please-32-chars-minimum"

# Base URL of the Node API server
API_URL="http://localhost:4000"

# Auth.js: trust the host header (required behind proxies / previews)
AUTH_TRUST_HOST="true"
